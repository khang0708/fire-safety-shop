# ====================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN FLAMEGUARD FIRE SAFETY
# ====================================================

# Port chạy của ứng dụng (mặc định: 3001)
PORT=3001

# Tên miền website (ví dụ: pcccphatantam.com)
DOMAIN=pcccphatantam.com

# (Tùy chọn) Chuỗi kết nối cơ sở dữ liệu Neon PostgreSQL
# Nếu để trống, hệ thống sẽ tự động dùng JSON Database lưu tại server/data/
DATABASE_URL=

# (Tùy chọn) Cấu hình thông báo đơn hàng Telegram Bot
# Có thể cấu hình trực tiếp tại trang Quản trị Admin hoặc điền ở đây
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====================================================
# BẢO MẬT & TÀI KHOẢN ADMIN PORTAL
# ====================================================
# Tên đăng nhập Admin (mặc định: admin)
ADMIN_USERNAME=admin
# Mật khẩu khởi tạo Admin (mặc định: FlameGuard@2026)
ADMIN_PASSWORD=FlameGuard@2026
# Mã PIN truy cập nhanh (mặc định: 1234)
ADMIN_PIN=1234
# Khóa bí mật ký JWT Session Token (tự động tạo ngẫu nhiên nếu để trống)
SESSION_SECRET=
