# ====================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN FLAMEGUARD FIRE SAFETY
# Sao chép thành .env trên VPS và điền giá trị THẬT. Không commit file .env.
# ====================================================

# Port chạy của ứng dụng (mặc định: 3001)
PORT=3001

# Tên miền website (ví dụ: pcccphatantam.com)
DOMAIN=pcccphatantam.com

# ====================================================
# LƯU TRỮ DỮ LIỆU
# ====================================================
# Thư mục dữ liệu chạy thật (đơn hàng, sản phẩm, cài đặt, tài khoản admin) NẰM NGOÀI thư mục repo,
# để deploy (git reset --hard) không bao giờ ghi đè. Docker mount thư mục này vào /data trong container.
# Dữ liệu mẫu nằm trong repo ở server/seed/ (chỉ đọc).
DATA_DIR=/var/lib/fire-safety-data

# Sao lưu hằng ngày: scripts/backup-data.sh (cài lịch bằng scripts/install-backup-cron.sh)
BACKUP_DIR=/var/backups/fire-safety
BACKUP_KEEP=14
# (Khuyến nghị) Đích sao chép ra NGOÀI VPS, ví dụ: rclone:remote:fire-safety  hoặc  user@host:/backups/fire-safety
BACKUP_REMOTE=

# (Tùy chọn) Chuỗi kết nối cơ sở dữ liệu Neon PostgreSQL. Để trống = dùng file JSON trong DATA_DIR.
DATABASE_URL=

# (Tùy chọn) Cấu hình thông báo đơn hàng Telegram Bot (BOT 1 - Dành cho Khách hàng / Chủ shop PCCC)
# Có thể cấu hình trực tiếp tại trang Quản trị Admin hoặc điền ở đây
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====================================================
# GIÁM SÁT SỰ CỐ MÁY CHỦ 24/7 (BOT 2 - DÀNH CHO DEVELOPER / DEVOPS)
# Tuyệt đối tách biệt với Bot Khách hàng, chuyên báo crash, lỗi 500 & downtime
# ====================================================
DEV_ALERT_TELEGRAM_TOKEN=
DEV_ALERT_TELEGRAM_CHAT_ID=

# ====================================================
# BẢO MẬT & TÀI KHOẢN ADMIN PORTAL
# ====================================================
# Tên đăng nhập Admin
ADMIN_USERNAME=admin
# BẮT BUỘC khi cài mới (chưa có admins.json): mật khẩu >= 10 ký tự, mã PIN 6-10 chữ số, không dùng dãy dễ đoán.
# Chỉ dùng để TẠO tài khoản lần đầu; sau đó đổi trong trang Quản trị hoặc bằng scripts/reset-admin.js.
# Mật khẩu/PIN mặc định cũ (FlameGuard@2026 / 1234) đã bị chặn đăng nhập vì từng công khai trong repo.
ADMIN_PASSWORD=
ADMIN_PIN=
# Khóa bí mật ký phiên đăng nhập (>= 16 ký tự). Để trống = tự sinh ngẫu nhiên và lưu trong DATA_DIR/.auth_secret.
SESSION_SECRET=
# Số lớp proxy phía trước ứng dụng (Nginx = 1). Dùng để lấy đúng IP khách cho giới hạn đăng nhập.
TRUST_PROXY_HOPS=1

# (Tùy chọn, bắt buộc nếu dùng chatbot Messenger) App Secret của ứng dụng Facebook để xác minh webhook.
# Chưa đặt = máy chủ từ chối mọi sự kiện webhook Facebook.
FACEBOOK_APP_SECRET=
