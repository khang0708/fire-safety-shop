# ====================================================
# CẤU HÌNH NGINX HTTPS & TỰ ĐỘNG CHUYỂN HƯỚNG HTTP SANG HTTPS
# Thay thế "YOUR_DOMAIN" bằng domain thật của bạn (ví dụ: cuahangpccc.vn)
# ====================================================

# Giới hạn tần suất đăng nhập admin theo IP (khai báo ở ngữ cảnh http; file conf.d được include trong http)
limit_req_zone $binary_remote_addr zone=fs_login:10m rate=10r/m;
server_tokens off;

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # Nơi cấp phát và tự động gia hạn SSL
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Tự động redirect sang HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # Giới hạn kích thước file upload
    client_max_body_size 30M;

    # Đường dẫn chứng chỉ SSL Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    # Cấu hình bảo mật SSL hiện đại
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Header bảo mật cơ bản
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Luồng sự kiện thời gian thực (SSE) của admin: không đệm, không bị ngắt sau 90 giây
    location = /api/admin/events {
        proxy_pass http://web:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Đăng nhập admin: giới hạn tần suất thêm một lớp ở Nginx (~10 lần/phút/IP, cho dồn 5)
    location = /api/auth/login {
        limit_req zone=fs_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://web:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90;
    }

    # Proxy sang Backend Node.js
    location / {
        proxy_pass http://web:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90;
    }
}
